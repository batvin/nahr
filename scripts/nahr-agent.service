[Unit]
Description=Nahr Tunnel Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=NODE_ENV=production
Environment=NAHR_TOKEN=CHANGE_ME
ExecStart=/usr/bin/node bin/nahr.js agent --port 7700 --id __USER__ --host 0.0.0.0
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
